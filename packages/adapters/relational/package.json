{
  "name": "@kalayaan/adapter-relational",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Shared relational (SQL) query builder and adapter base for Kalayaan storage adapters.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/adapters/relational"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
