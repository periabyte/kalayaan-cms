{
  "name": "@kalayaan/adapter-d1",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Cloudflare D1 storage adapter for Kalayaan.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/adapters/d1"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/adapter-relational": "workspace:*",
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@kalayaan/adapter-conformance": "workspace:^",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
}
