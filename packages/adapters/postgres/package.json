{
  "name": "@kalayaan/adapter-postgres",
  "version": "0.3.1",
  "license": "MIT",
  "description": "PostgreSQL storage adapter for Kalayaan.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/adapters/postgres"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/adapter-relational": "workspace:*",
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*"
  },
  "peerDependencies": {
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kalayaan/adapter-conformance": "workspace:^",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
}
