{
  "name": "@kalayaan/core",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Kalayaan core contracts: query DSL types, DatabaseAdapter/StorageAdapter/AIProvider/EmailProvider interfaces, the Ability RBAC model, and shared errors/helpers.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/config": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "tsup": "^8.4.0",
    "vitest": "^4.1.10"
  }
}
