{
  "name": "@kalayaan/cli",
  "version": "0.1.3",
  "license": "MIT",
  "description": "The `kalayaan` CLI implementation (login/init/dev/migrate/deploy/doctor/down). Most users should install the `kalayaan` package instead.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": {
      "import": "./dist/bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@kalayaan/adapter-d1": "workspace:*",
    "@kalayaan/admin": "workspace:*",
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*",
    "@kalayaan/runtime": "workspace:*",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "wrangler": "^4.114.0",
    "@kalayaan/adapter-relational": "workspace:*",
    "@kalayaan/adapter-postgres": "workspace:*",
    "@kalayaan/adapter-mysql": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.4.0",
    "vitest": "^4.1.10"
  },
  "bin": {
    "kalayaan": "./dist/bin.js"
  }
}
