{
  "name": "@kalayaan/runtime",
  "version": "0.3.1",
  "license": "MIT",
  "description": "The Hono application powering a Kalayaan site: content API, admin API, auth/RBAC, media, AI, GraphQL, MCP, and public submissions.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/adapter-d1": "workspace:*",
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*",
    "@kalayaan/storage-r2": "workspace:*",
    "hono": "^4.12.31",
    "zod": "^4.4.3",
    "@kalayaan/adapter-postgres": "workspace:*",
    "@kalayaan/adapter-mysql": "workspace:*",
    "graphql": "^16.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
}
