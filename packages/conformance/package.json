{
  "name": "@kalayaan/adapter-conformance",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Shared conformance test suite for Kalayaan DatabaseAdapter implementations.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/conformance"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --external vitest",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/config": "workspace:*",
    "@kalayaan/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "vitest": "^3.2.7"
  }
}
