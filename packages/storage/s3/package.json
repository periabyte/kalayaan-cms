{
  "name": "@kalayaan/storage-s3",
  "version": "0.1.3",
  "license": "MIT",
  "description": "S3-compatible media storage adapter for Kalayaan.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/storage/s3"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalayaan/core": "workspace:*"
  },
  "peerDependencies": {
    "aws4fetch": "^1.0.18"
  },
  "peerDependenciesMeta": {
    "aws4fetch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0"
  }
}
