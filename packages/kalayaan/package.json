{
  "name": "kalayaan",
  "version": "0.1.3",
  "license": "MIT",
  "description": "A config-driven, self-deploying headless CMS for Cloudflare Workers, D1, R2, and KV. One cms.config.ts + `kalayaan login → init → deploy` yields a live site.",
  "homepage": "https://kalayaan.periabyte.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/periabyte/kalayaan-cms.git",
    "directory": "packages/kalayaan"
  },
  "bugs": "https://github.com/periabyte/kalayaan-cms/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "import": "./dist/mysql.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts src/postgres.ts src/mysql.ts --format esm --dts --sourcemap",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "kalayaan": "./dist/bin.js"
  },
  "dependencies": {
    "@kalayaan/cli": "workspace:*",
    "@kalayaan/config": "workspace:*",
    "@kalayaan/runtime": "workspace:*",
    "@kalayaan/core": "workspace:*",
    "@kalayaan/adapter-postgres": "workspace:*",
    "@kalayaan/adapter-mysql": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "vitest": "^4.1.10"
  }
}
